# --- Base de datos (MySQL) ---
# Estos valores los lee docker-compose.yml y los recibe PHP como variables de entorno.
DB_NAME=fenix_db
DB_USER=fenix_user
DB_PASSWORD=milanesa
DB_ROOT_PASSWORD=admin

# --- phpMyAdmin ---
# Se usa en http://localhost:8080
# Usuario para entrar: fenix_user (con DB_PASSWORD) o root (con DB_ROOT_PASSWORD)
PMA_PORT=8080

# --- Aplicación ---
APP_PORT=3000
TZ=America/Montevideo